# Aarka Tech environment settings. Copy to .env (git-ignored). Every value is optional.
# The command-line tools (scanner, evaluators) read this file. The web app reads only its own
# process environment: export the same variables in your shell, or set them in the launch agent.

# Where your data lives (cv.md, config/, data/, reports/, output/). Default: this checkout.
# CAREER_OPS_ROOT=/path/to/aarka-tech

# Web app address. Keep 127.0.0.1 so the app is reachable only from this computer.
# HOSTNAME=127.0.0.1
# PORT=3000

# Allow extra hosts or origins to reach the web app (off by default; see docs/PRIVACY.md).
# CAREER_OPS_WEB_ALLOWED_HOSTS=
# CAREER_OPS_ALLOWED_ORIGINS=

# Background automation folder. Default: ./automation in this checkout.
# ARKA_AUTOMATION_DIR=

# AI engine state (provider order, health, cache). Default: automation/ai-engine/state
# ARKA_AI_STATE=

# Encrypted personal-records vault folder (macOS). Default: ~/Library/Application Support/careerops/vault
# ARKA_VAULT_DIR=

# Gmail OAuth client and token folder. Default: ~/Library/Application Support/careerops
# CAREEROPS_SECRETS_DIR=

# Slow career sites: per-request timeout for the scanner, in milliseconds.
# CAREER_OPS_HTTP_TIMEOUT_MS=60000

# API keys are NOT configured here. Add them in Integrations & Settings; they go to the
# macOS Keychain. Never put real keys in this file or in any committed file.
