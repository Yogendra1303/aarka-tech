# Settings for the scheduled pipeline (sourced by daily.sh and tick.sh).
# Copy to config.env and adjust. config.env is git-ignored.
AUTO_DIR="${AUTO_DIR:-${0:A:h}}"
CO_DIR="${CO_DIR:-${AUTO_DIR:h}}"        # the Aarka Tech checkout (parent of automation/)
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export CAREER_OPS_HTTP_TIMEOUT_MS=60000  # some career sites are slow
SCAN_RETRIES=3                           # whole-scan retries, 60s apart
LIVENESS_MAX=40                          # postings re-checked for expiry per run

# ---- AI stage. OFF by default. Turning it on spends usage on the AI provider you configured.
AI_ENABLED=0
AI_MAX_RANK=60           # pending roles ranked per day
AI_MAX_EVALS=3           # full evaluations per day
AI_MAX_PACKS=2           # resume + cover letter + outreach packs per day
AI_MIN_RANK=4.0          # rank needed to queue an evaluation
AI_MIN_SCORE=4.0         # evaluation score needed for an application pack
AI_EVAL_MODEL="claude-haiku-4-5"
AI_PACK_MODEL="claude-sonnet-5-5"
